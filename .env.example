# Скопируйте в .env и заполните
RUST_TOKEN=замените-на-длинный-случайный-токен
# Если приложение открывается по адресу https://host/kofi/, укажите /kofi. Иначе оставьте пустым.
RUST_BASE_PATH=
RUST_MAX_PARALLEL=1
# Версия CUDA для torch. cu129 подходит для драйвера 525+ и карт от Pascal до RTX 50.
# Старая карта и драйвер: .../whl/cu126. Драйвер 580+: .../whl/cu130.
# TORCH_INDEX=https://download.pytorch.org/whl/cu129
